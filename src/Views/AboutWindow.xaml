<Window x:Class="PrMonitor.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About PR Monitor"
        Width="360"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0D1117">

    <Border Margin="12" Padding="20" Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8">
        <StackPanel>

            <!-- Logo + name + version -->
            <Image Width="256" Height="256" Margin="0,0,0,14"
                   HorizontalAlignment="Center"
                   Stretch="Uniform"
                   Source="/Assets/logo_256.png"/>

            <TextBlock Text="PR Monitor"
                       HorizontalAlignment="Center"
                       Foreground="#E6EDF3"
                       FontSize="18"
                       FontWeight="SemiBold"/>

            <TextBlock Text="{Binding VersionText}"
                       HorizontalAlignment="Center"
                       Foreground="#8B949E"
                       FontSize="12"
                       Margin="0,4,0,0"/>

            <!-- Divider -->
            <Border Height="1" Background="#21262D" Margin="0,16,0,16"/>

            <!-- Repository link -->
            <TextBlock HorizontalAlignment="Center" FontSize="13" Foreground="#C9D1D9">
                <Run Text="GitHub: "/>
                <Hyperlink NavigateUri="https://github.com/jvanoostveen/pr-monitor"
                           RequestNavigate="RepoLink_RequestNavigate"
                           Foreground="#58A6FF">
                    <Run Text="jvanoostveen/pr-monitor"/>
                </Hyperlink>
            </TextBlock>

            <!-- Buttons -->
            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="Check for updates…"
                        Style="{StaticResource SecondaryButton}"
                        Click="CheckForUpdates_Click"/>
                <Button Grid.Column="2"
                        Content="Copy diagnostics"
                        Style="{StaticResource SecondaryButton}"
                        Click="CopyDiagnostics_Click"/>
            </Grid>

            <Button Content="Close"
                    Width="120" Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    Style="{StaticResource PrimaryButton}"
                    Click="Close_Click"
                    IsCancel="True"/>

        </StackPanel>
    </Border>
</Window>
