<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.13.1</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <AssemblyName>PrMonitor</AssemblyName>
    <Title>PR Monitor</Title>
    <Description>PR Monitor</Description>
    <Product>PR Monitor</Product>
    <RootNamespace>PrMonitor</RootNamespace>

    <!-- Tray app: prioritise a small, promptly-released heap over allocation throughput. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <RetainVMGarbageCollection>false</RetainVMGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <!-- Levels 1-9; makes the GC collect more eagerly and give pages back to the OS. -->
    <RuntimeHostConfigurationOption Include="System.GC.Conserve" Value="5" Trim="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\logo_256.png" />
    <Resource Include="Assets\Fonts\MaterialSymbolsRounded-Regular.ttf" />
  </ItemGroup>

</Project>
